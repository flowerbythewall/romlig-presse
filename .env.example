# Commerce backend — pick one.
# local | shopify | medusa
# Anything else fails the build. Only an unset value falls back to local.
NEXT_PUBLIC_COMMERCE_PROVIDER=local

# --- Shopify (Storefront API) ---
# Storefront API token (not the Admin API token), with
# unauthenticated_read_product_listings and unauthenticated_write_checkouts.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# --- Medusa v2 ---
# MEDUSA_REGION_ID is required — prices are resolved per region, and it must be
# a region whose currency is USD.
MEDUSA_BACKEND_URL=https://your-medusa.com
MEDUSA_PUBLISHABLE_KEY=pk_...
MEDUSA_REGION_ID=reg_...

# --- Prices are USD ---
# Both backends are checked against CURRENCY in lib/types.ts; a product priced in
# another currency fails the build rather than rendering a foreign price as $.
