# Commerce backend — pick one.
# local | shopify | medusa
NEXT_PUBLIC_COMMERCE_PROVIDER=local

# --- Shopify (Storefront API) ---
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# --- Medusa v2 ---
# MEDUSA_REGION_ID is required — prices are resolved per region.
MEDUSA_BACKEND_URL=https://your-medusa.com
MEDUSA_PUBLISHABLE_KEY=pk_...
MEDUSA_REGION_ID=reg_...
